<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /public/
    
    # Allow direct access to files and directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Route all other requests to index.php
    RewriteRule ^(.+)$ index.php?url=$1 [QSA,L]
</IfModule>
